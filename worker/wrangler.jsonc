{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ser-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGIN": "*"
  }
  // To connect PostgreSQL with Hyperdrive connection pooling, add:
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<your-hyperdrive-id>"
  //   }
  // ]
}
